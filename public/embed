/**
 * Stance Capture Embed Widget v1
 * https://stancecapture.com
 *
 * Drop one <script> tag on your page, then add divs like:
 *   <div data-sc-question="<question-uuid>" data-sc-theme="light"></div>
 *
 * The script auto-detects all data-sc-question divs and injects iframes.
 * Safe to load async. Multiple embeds per page are supported.
 */
(function () {
  "use strict";

  var BASE_URL = "https://stancecapture.com";
  var EMBED_PATH = "/#/embed/";
  var MIN_HEIGHT = 280;
  var MAX_HEIGHT = 480;

  function getBaseUrl() {
    // Allow override for self-hosted / dev environments
    var scripts = document.querySelectorAll("script[src*='embed.js']");
    if (scripts.length > 0) {
      var src = scripts[scripts.length - 1].getAttribute("src") || "";
      var match = src.match(/^(https?:\/\/[^/]+)/);
      if (match) return match[1];
    }
    return BASE_URL;
  }

  function buildEmbedUrl(questionId, theme, cta, ref) {
    var base = getBaseUrl();
    var params = new URLSearchParams();
    if (theme) params.set("theme", theme);
    if (cta) params.set("cta", cta);
    if (ref) params.set("ref", ref);
    var qs = params.toString() ? "?" + params.toString() : "";
    return base + EMBED_PATH + questionId + qs;
  }

  function createIframe(src, containerId) {
    var iframe = document.createElement("iframe");
    iframe.src = src;
    iframe.id = "sc-iframe-" + containerId;
    iframe.setAttribute("frameborder", "0");
    iframe.setAttribute("scrolling", "no");
    iframe.setAttribute("allow", "forms");
    iframe.setAttribute("title", "Stance Capture question");
    iframe.style.width = "100%";
    iframe.style.height = MIN_HEIGHT + "px";
    iframe.style.border = "none";
    iframe.style.borderRadius = "12px";
    iframe.style.overflow = "hidden";
    iframe.style.display = "block";
    return iframe;
  }

  function injectEmbed(div) {
    var questionId = div.getAttribute("data-sc-question");
    if (!questionId) return;

    // Avoid double-injection
    if (div.getAttribute("data-sc-injected")) return;
    div.setAttribute("data-sc-injected", "1");

    var theme = div.getAttribute("data-sc-theme") || "light";
    var cta = div.getAttribute("data-sc-cta") || null;
    var ref = div.getAttribute("data-sc-ref") || null;

    var containerId = questionId.slice(0, 8);
    var src = buildEmbedUrl(questionId, theme, cta, ref);
    var iframe = createIframe(src, containerId);

    // Preserve any existing styles on the container div
    div.style.display = "block";
    div.style.overflow = "hidden";

    // Clear the div and inject the iframe
    div.innerHTML = "";
    div.appendChild(iframe);

    // Track impression (fire-and-forget)
    trackImpression(questionId, ref);
  }

  function trackImpression(questionId, ref) {
    try {
      var fp = getFingerprint();
      var supabaseUrl = window.SC_SUPABASE_URL || "https://yzxzpnomcarnxixhjlba.supabase.co";
      var anonKey = window.SC_ANON_KEY || "";

      fetch(supabaseUrl + "/rest/v1/embed_impressions", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "apikey": anonKey,
          "Authorization": "Bearer " + anonKey,
          "Prefer": "return=minimal",
        },
        body: JSON.stringify({
          question_id: questionId,
          publisher_ref: ref || null,
          device_fingerprint: fp,
        }),
        keepalive: true,
      }).catch(function () {}); // Silently ignore failures
    } catch (e) {}
  }

  function getFingerprint() {
    var key = "sc_embed_fp_v1";
    try {
      var existing = localStorage.getItem(key);
      if (existing) return existing;
      var fp = (crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).slice(2) + Date.now().toString(36));
      localStorage.setItem(key, fp);
      return fp;
    } catch (e) {
      return "unknown";
    }
  }

  // Listen for postMessage events from embed iframes
  function handleMessage(event) {
    if (!event.data || typeof event.data !== "object") return;
    var msg = event.data;

    switch (msg.type) {
      case "sc:resize":
        // Auto-resize the iframe to match content height
        var iframes = document.querySelectorAll("iframe[id^='sc-iframe-']");
        for (var i = 0; i < iframes.length; i++) {
          var iframe = iframes[i];
          if (iframe.contentWindow === event.source) {
            var height = Math.min(Math.max(msg.height || MIN_HEIGHT, MIN_HEIGHT), MAX_HEIGHT);
            iframe.style.height = height + "px";
          }
        }
        break;

      case "sc:stance_submitted":
        // Call publisher callback if provided
        if (typeof window.onStanceCaptureSubmit === "function") {
          try {
            window.onStanceCaptureSubmit({
              questionId: msg.questionId,
              stanceValue: msg.stanceValue,
            });
          } catch (e) {}
        }
        break;

      case "sc:signup_clicked":
        // Optional: publishers can listen for this to show their own overlay
        if (typeof window.onStanceCaptureSignupClick === "function") {
          try {
            window.onStanceCaptureSignupClick();
          } catch (e) {}
        }
        break;
    }
  }

  function init() {
    window.addEventListener("message", handleMessage);

    // Inject all existing data-sc-question divs
    var divs = document.querySelectorAll("[data-sc-question]");
    for (var i = 0; i < divs.length; i++) {
      injectEmbed(divs[i]);
    }

    // Watch for dynamically added divs (e.g. in SPAs)
    if (window.MutationObserver) {
      var observer = new MutationObserver(function (mutations) {
        for (var i = 0; i < mutations.length; i++) {
          var added = mutations[i].addedNodes;
          for (var j = 0; j < added.length; j++) {
            var node = added[j];
            if (node.nodeType !== 1) continue;
            if (node.getAttribute && node.getAttribute("data-sc-question")) {
              injectEmbed(node);
            }
            var children = node.querySelectorAll ? node.querySelectorAll("[data-sc-question]") : [];
            for (var k = 0; k < children.length; k++) {
              injectEmbed(children[k]);
            }
          }
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }
  }

  // Run on DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
