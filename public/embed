/**
 * embed.js — Stance Capture Publisher Embed Script
 * Epic T — T1: Single script tag deployment
 *
 * Usage (publisher adds to their article page):
 *
 *   <div
 *     data-sc-question="<question-uuid>"
 *     data-sc-theme="light"
 *     data-sc-cta="What do you think?"
 *     data-sc-ref="my-publication"
 *   ></div>
 *   <script src="https://your-domain.com/embed.js" async></script>
 *
 * Attributes on the <div>:
 *   data-sc-question  (required) UUID of the question to embed
 *   data-sc-theme     light | dark | auto  (default: light)
 *   data-sc-cta       Custom CTA text shown after submission (optional)
 *   data-sc-ref       Publisher identifier for analytics (optional)
 *   data-sc-height    Fixed height in px — disables auto-resize (optional)
 *
 * postMessage events emitted from the iframe:
 *   { type: "sc:resize",          height: number }
 *   { type: "sc:stance_submitted", questionId: string, stanceValue: number }
 *   { type: "sc:signup_clicked" }
 *
 * The script is idempotent — running multiple times does not create
 * duplicate iframes. Each container div is processed once.
 */

(function () {
  "use strict";

  // ── Resolve the base URL from this script's own src attribute ───────────────
  // Works whether the script is loaded sync or async.
  var BASE_URL = (function () {
    // Modern: document.currentScript
    if (document.currentScript && document.currentScript.src) {
      return document.currentScript.src.replace(/\/embed\.js(\?.*)?$/, "");
    }
    // Fallback: scan all script tags
    var scripts = document.querySelectorAll("script[src]");
    for (var i = 0; i < scripts.length; i++) {
      var src = scripts[i].getAttribute("src") || "";
      if (src.indexOf("embed.js") !== -1) {
        return src.replace(/\/embed\.js(\?.*)?$/, "");
      }
    }
    // Last resort: same origin
    return window.location.origin;
  }());

  var EMBED_ATTR      = "data-sc-question";
  var MOUNTED_ATTR    = "data-sc-mounted";
  var DEFAULT_HEIGHT  = 320; // px — used before first sc:resize message

  // ── Mount one container ────────────────────────────────────────────────────

  function mountContainer(container) {
    // Skip if already mounted
    if (container.getAttribute(MOUNTED_ATTR)) return;
    container.setAttribute(MOUNTED_ATTR, "1");

    var questionId  = container.getAttribute(EMBED_ATTR);
    if (!questionId) return;

    var theme       = container.getAttribute("data-sc-theme")  || "light";
    var ref         = container.getAttribute("data-sc-ref")    || "";
    var cta         = container.getAttribute("data-sc-cta")    || "";
    var fixedHeight = container.getAttribute("data-sc-height");

    // Build iframe src — app uses HashRouter so embed route is /#/embed/:id
    var params = new URLSearchParams();
    params.set("theme", theme);
    if (ref) params.set("ref", ref);
    if (cta) params.set("cta", cta);

    var iframeSrc = BASE_URL + "/#/embed/" + encodeURIComponent(questionId) + "?" + params.toString();

    // ── Create iframe ────────────────────────────────────────────────────────
    var iframe = document.createElement("iframe");

    iframe.setAttribute("src", iframeSrc);
    iframe.setAttribute("frameborder", "0");
    iframe.setAttribute("scrolling", "no");
    iframe.setAttribute("allowtransparency", "true");
    iframe.setAttribute("title", "Stance Capture — share your view");

    // Accessibility
    iframe.setAttribute("aria-label", "Stance Capture interactive question");

    // Sandbox — allow forms + scripts + same-origin; block popups except via user gesture
    iframe.setAttribute(
      "sandbox",
      "allow-scripts allow-forms allow-same-origin allow-popups allow-popups-to-escape-sandbox"
    );

    // Responsive width, initial height
    iframe.style.cssText = [
      "width:100%",
      "border:none",
      "display:block",
      "overflow:hidden",
      "transition:height 0.2s ease",
      "height:" + (fixedHeight ? fixedHeight + "px" : DEFAULT_HEIGHT + "px"),
    ].join(";");

    // Container sizing
    container.style.cssText = [
      "display:block",
      "width:100%",
      "max-width:680px",           // reasonable editorial column width
      "margin:1.5rem auto",
    ].join(";");

    container.innerHTML = "";
    container.appendChild(iframe);

    // ── Auto-resize via postMessage ──────────────────────────────────────────
    if (!fixedHeight) {
      window.addEventListener("message", function (event) {
        // Security: only accept messages from our own origin
        if (event.origin !== BASE_URL) return;

        var data = event.data;
        if (!data || typeof data !== "object") return;

        if (data.type === "sc:resize" && typeof data.height === "number") {
          // Only resize the iframe that sent the message
          try {
            if (iframe.contentWindow === event.source) {
              var newHeight = Math.max(200, Math.min(900, data.height + 16));
              iframe.style.height = newHeight + "px";
            }
          } catch (e) {
            // cross-origin safety — ignore
          }
        }
      });
    }
  }

  // ── Find and mount all containers ─────────────────────────────────────────

  function mountAll() {
    var containers = document.querySelectorAll("[" + EMBED_ATTR + "]");
    for (var i = 0; i < containers.length; i++) {
      mountContainer(containers[i]);
    }
  }

  // ── Observer for containers added after initial page load ─────────────────
  // Handles CMS lazy-load, SPA navigation, and deferred article injection.

  function startObserver() {
    if (typeof MutationObserver === "undefined") return;

    var observer = new MutationObserver(function (mutations) {
      var found = false;
      for (var i = 0; i < mutations.length; i++) {
        var nodes = mutations[i].addedNodes;
        for (var j = 0; j < nodes.length; j++) {
          var node = nodes[j];
          if (node.nodeType !== 1) continue; // Element nodes only

          // Check if the added node itself is a container
          if (node.getAttribute && node.getAttribute(EMBED_ATTR)) {
            found = true;
            break;
          }
          // Check descendants
          if (node.querySelector && node.querySelector("[" + EMBED_ATTR + "]")) {
            found = true;
            break;
          }
        }
        if (found) break;
      }
      if (found) mountAll();
    });

    observer.observe(document.body, { childList: true, subtree: true });
  }

  // ── Boot ───────────────────────────────────────────────────────────────────

  function boot() {
    mountAll();
    startObserver();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    // Already interactive or complete
    boot();
  }

}());
