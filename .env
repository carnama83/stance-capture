# ─────────────────────────────────────────────────────────────────────────────
# Stance Capture — base environment template
# ─────────────────────────────────────────────────────────────────────────────
# This file is committed to git. It contains NO secrets — only documentation.
#
# HOW ENVIRONMENTS WORK
# ─────────────────────
# Vite loads environment files in this order (later overrides earlier):
#   .env                      ← this file (base, always loaded, committed)
#   .env.{mode}               ← mode-specific file (gitignored, never committed)
#   .env.{mode}.local         ← local override (gitignored, never committed)
#
# Modes:
#   npm run dev               → mode = "development" → loads .env.development
#   npm run build:uat         → mode = "uat"         → loads .env.uat
#   npm run build             → mode = "production"  → loads .env.production
#
# For deployed environments (Vercel), set variables in:
#   Vercel dashboard → Project → Settings → Environment Variables
#   Production:  points at prod Supabase project (yzxzpnomcarnxixhjlba)
#   Preview:     points at UAT Supabase project
#
# SETUP FOR A NEW DEVELOPER
# ─────────────────────────
# 1. Copy .env.development.example → .env.development
# 2. Fill in the dev Supabase anon key (from Supabase dashboard → stance-capture-dev)
# 3. Run: npm run dev
#
# NEVER commit .env.development, .env.uat, or .env.production to git.
# ─────────────────────────────────────────────────────────────────────────────

# Required — set in the mode-specific file (.env.development / .env.uat / .env.production)
# or in Vercel environment variables for deployed builds.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional feature flags (safe to set here if they're the same across all envs)
# VITE_ENABLE_TRENDING_DEBUG=false
